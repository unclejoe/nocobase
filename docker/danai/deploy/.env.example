# ===== 必填：两把密钥，首次部署时生成，之后永不可改 =====
# 生成方式：openssl rand -base64 32
# ENCRYPTION_FIELD_KEY 一旦投入使用再修改，历史加密字段（如存储的密码）将无法解密。
APP_KEY=
ENCRYPTION_FIELD_KEY=

# ===== 数据库（默认指向 compose 内的 postgres 服务；若用云托管数据库改这里）=====
DB_DIALECT=postgres
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nocobase
DB_USER=nocobase
DB_PASSWORD=

# ===== 初始管理员（可选，不填则首次访问页面时注册/使用默认账号）=====
# INIT_ROOT_EMAIL=admin@nocobase.com
# INIT_ROOT_PASSWORD=admin123
# INIT_ROOT_NICKNAME=Admin
# INIT_ROOT_USERNAME=admin

# ===== 品牌定制（可选，DAN.AI 默认值）=====
# APP_BRAND_TITLE=DAN.AI
# APP_BRAND_HOMEPAGE_URL=https://dan.ai
# APP_BRAND_DOCS_URL=https://docs.dan.ai
# APP_BRAND_AGREEMENT_URL=https://dan.ai/agreement
